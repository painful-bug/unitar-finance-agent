GROQ_API_KEY=
TYPESAFE_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
